#cloud-config
autoinstall:
  version: 1

  ssh:
    install-server: true
    allow-pw: true

  # Reboot (not poweroff) so packer can SSH in after installation
  shutdown: reboot

  identity:
    realname: 'CAPE Sandbox'
    username: cape
    # Generated with: python3 -c "import crypt; print(crypt.crypt('cape', crypt.mksalt(crypt.METHOD_SHA512)))"
    password: '$6$SIb9UZfFgSJ720V3$aGf1VAqNpF4Hg5aK8oEdsY8uXwscb8IK7prdNFn0HhMI.vtAfITtqhAT2IGpMN5sAs.b8VLwj4wpjwhVlJ8kw1'
    hostname: cape-sandbox

  storage:
    layout:
      name: direct

  # Use HWE kernel for best KVM/driver support on 24.04 point releases
  early-commands:
    - echo 'linux-generic-hwe-24.04' > /run/kernel-meta-package

  late-commands:
    # Remove filesystem tools not needed with direct storage layout
    - >-
      curtin in-target -- apt-get remove -y
      btrfs-progs cryptsetup* lvm2 xfsprogs

    # Remove packages not needed for CAPE host
    - >-
      curtin in-target -- apt-get remove -y
      byobu dmeventd finalrd kpartx mdadm ncurses-term needrestart open-iscsi
      sg3-utils sssd sosreport motd-news-config lxd-agent-loader landscape-common

    - curtin in-target -- apt-get autoremove -y

    # Force legacy eth0 interface naming (net.ifnames=0) so the host NIC name is
    # identical across qemu/vmware/virtualbox builders. Drop-in is sourced after
    # /etc/default/grub by grub-mkconfig; appends to GRUB_CMDLINE_LINUX_DEFAULT.
    - >-
      curtin in-target -- bash -c 'printf "%s\n" "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT net.ifnames=0 biosdevname=0\"" > /etc/default/grub.d/eth0.cfg'

    # The installer uses ttyS0 as its primary console so headless builds retain
    # complete logs. Keep that serial console in the installed VM, but append
    # tty0 last so /dev/console (including systemd service output) is displayed
    # in the hypervisor's graphical console. The zz prefix makes this the last
    # GRUB defaults drop-in even after the custom eth0.cfg above.
    - >-
      curtin in-target -- bash -c 'printf "%s\n" "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT console=tty0\"" > /etc/default/grub.d/zz-display-console.cfg'
    - curtin in-target -- update-grub

  error-commands:
    - tar -czf /run/installer-logs.tar.gz /var/log/installer/ /var/log/subiquity.log /var/log/cloud-init*.log /var/log/casper.log 2>/dev/null || true
    - journalctl -b --no-pager > /run/installer-journal.txt 2>/dev/null || true
    - shutdown -P now || true
