<domain type='kvm'>
  <name>cape-win10</name>
  <!-- 2GB RAM; adjust if needed -->
  <memory unit='KiB'>2097152</memory>
  <vcpu placement='static'>2</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <!-- edk2 Secure Boot firmware; matches OVMF_CODE_4M.ms.fd used by auto-windows-vm -->
    <loader readonly='yes' type='pflash'>/usr/share/qemu/edk2-x86_64-secure-code.fd</loader>
    <nvram template='/usr/share/qemu/edk2-i386-vars.fd'>/var/lib/libvirt/qemu/nvram/cape-win10_VARS.fd</nvram>
  </os>
  <features>
    <acpi/>
    <apic/>
    <smm state='on'/>
    <!-- Hyper-V enlightenments for Windows performance; hypervisor flag
         disabled so the guest cannot detect it is running in a VM -->
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
    </hyperv>
  </features>
  <cpu mode='host-model'>
    <feature policy='disable' name='hypervisor'/>
  </cpu>
  <clock offset='localtime'>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <!-- Replaced by import-guest.sh -->
      <source file='CAPE_QCOW2_PATH'/>
      <target dev='sda' bus='sata'/>
    </disk>
    <interface type='network'>
      <!-- Attaches to the 192.168.56.0/24 analysis network -->
      <!-- MAC must match win10_guest_mac in variables.pkrvars.hcl and cape-win10.jsonnet -->
      <mac address='CAPE_WIN10_GUEST_MAC'/>
      <source network='cape'/>
      <model type='e1000e'/>
    </interface>
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video>
      <model type='vga'/>
    </video>
  </devices>
</domain>
